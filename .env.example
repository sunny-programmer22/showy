# ==============================================================
# SHOPTASTIC.BD — Environment Variables
# Copy this file to ".env" and fill in your values.
#
# WHERE TO FIND THESE:
#   Supabase Dashboard → Your Project → Settings (gear icon)
#   → API → "Project URL" and "anon public" key
#
# NOTE: In Vite, ONLY variables starting with VITE_ are exposed
#       to the frontend. Never put secret/service_role keys here!
# ==============================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
