{
  "name": "Showy — Multi-Vendor Marketplace",
  "short_name": "Showy",
  "description": "Bangladesh's multi-vendor marketplace. Shop from verified sellers or open your own online shop in minutes.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "lang": "en",
  "categories": ["shopping", "business"],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Browse Products", "url": "/products", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] },
    { "name": "Explore Shops", "url": "/shops", "icons": [{ "src": "./icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": []
}
